---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import FormattedDate from '../components/FormattedDate.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 5);
const projects = (await getCollection('projects', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 5);
---
<Base>
  <h1>Hi, I'm Jozef.</h1>
  <p class="lede">This is my corner of the internet: writing, work I'm proud of, and whatever I'm tinkering with.</p>

  <div class="home-grid">
    <section>
      <h2 class="section-title">Latest posts</h2>
      <ul class="list">
        {posts.map((p) => (
          <li><a href={`/blog/${p.id}/`}>{p.data.title}</a><span class="muted"><FormattedDate date={p.data.date} /></span></li>
        ))}
      </ul>
      <a class="more" href="/blog/">All posts →</a>
    </section>
    <section>
      <h2 class="section-title">Projects</h2>
      <ul class="list">
        {projects.map((p) => (
          <li><a href={`/projects/${p.id}/`}>{p.data.title}</a><span class="muted status">{p.data.status}</span></li>
        ))}
      </ul>
      <a class="more" href="/projects/">All projects →</a>
    </section>
  </div>
</Base>
