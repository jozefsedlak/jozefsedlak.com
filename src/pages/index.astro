---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import FormattedDate from '../components/FormattedDate.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 5);
const projects = (await getCollection('projects', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 5);
---
<Base>
  <h1>Hi, I'm Jozef.</h1>
  <p>This is my corner of the internet: writing, work I'm proud of, and whatever I'm tinkering with.</p>

  <h2>Latest posts</h2>
  <ul class="list">
    {posts.map((p) => (
      <li><a href={`/blog/${p.id}/`}>{p.data.title}</a> <span class="muted">· <FormattedDate date={p.data.date} /></span></li>
    ))}
  </ul>

  <h2>Projects</h2>
  <ul class="list">
    {projects.map((p) => (
      <li><a href={`/projects/${p.id}/`}>{p.data.title}</a> <span class="muted">· {p.data.status}</span><br />{p.data.description}</li>
    ))}
  </ul>
</Base>
